# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# CRITICAL: Change these before deploying. Never commit real values.
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX_access
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX_refresh

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/hicc

# ── Redis (production rate-limiting + token store) ─────────────────────────
REDIS_URL=redis://localhost:6379
